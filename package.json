{
  "name": "books",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro sync && tsc && astro build",
    "preview": "npm run build && astro preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "smoke": "sh scripts/smoke.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "The one password that unlocks the library. Changing it signs out every session."
      }
    }
  }
}
