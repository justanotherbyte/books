{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "books",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "books" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "books",
      // Replace with the id printed by `wrangler d1 create books` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
